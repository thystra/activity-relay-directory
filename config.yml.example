# Optional public presentation metadata for the human Activity-Relay Directory
# page. This example is package-managed; the live config.yml remains entirely
# operator-owned and is never created or overwritten by package upgrades.
#
# To enable a commented setting, delete only the leading #. The indentation
# after # is already the indentation required by YAML.
#
# DIRECTORY-TITLE replaces the default "Activity-Relay Directory" page and
# header title. DIRECTORY-BANNER-URL is an optional absolute HTTPS image URL;
# when configured, the page CSP permits images only from that exact HTTPS
# origin (plus self). Empty values are not rendered.
#DIRECTORY-TITLE: "Community Relay Directory"
#DIRECTORY-BANNER-URL: "https://directory.example.org/assets/banner.jpg"

# Optional public operator metadata. FEDIVERSE-OPERATOR-ID and
# FEDIVERSE-OPERATOR-URL form one logical contact object. If only one is set,
# no partial Fediverse link is published and an operator-facing diagnostic is
# shown instead. Malformed nice-to-have values are suppressed without stopping
# the core service. Structural YAML/file errors remain fatal.
#OPERATOR-WEBSITE: "https://example.org/"
#OPERATOR-EMAIL: "operator@example.org"
#FEDIVERSE-OPERATOR-ID: "@operator@social.example"
#FEDIVERSE-OPERATOR-URL: "https://social.example/@operator"

# Optional public support methods. Each entry needs a title and exactly one of
# an absolute HTTPS url or a plain-text value. No HTML, Markdown, embeds,
# scripts, pixels, or third-party content are accepted.
#SUPPORT:
#  - title: "Liberapay"
#    url: "https://liberapay.com/example/"
#  - title: "Bitcoin"
#    value: "bc1qexample"
