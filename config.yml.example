# Optional public operator metadata for the human Activity-Relay Directory page.
#
# Debian operators may copy this file to:
#   /etc/activity-relay-directory/config.yml
#
# Container operators may mount a file and set DIRECTORY_CONFIG_PATH to its
# absolute path. Empty values are not rendered. FEDIVERSE-OPERATOR-ID and
# FEDIVERSE-OPERATOR-URL form one logical contact object. If only one is set,
# no partial Fediverse link is published and the human page identifies the
# missing key. Malformed Nice-to-have values are likewise suppressed and shown
# as operator-facing configuration diagnostics without stopping the core
# service. The Fediverse URL is explicit because profile URL shapes differ
# between applications.
#
# OPERATOR-EMAIL uses a deliberately loose syntax check: local text, @, a
# dotted domain, and a nonempty suffix. There is no fixed TLD allowlist.
# Structural YAML/file errors remain fatal because the file was not parsed
# successfully.
#
# This file is presentation-only. Runtime policy remains in the existing
# DIRECTORY_* process environment, and DIRECTORY_ADMIN_EMAIL is never made
# public implicitly.

OPERATOR-WEBSITE: ""
OPERATOR-EMAIL: ""
FEDIVERSE-OPERATOR-ID: ""
FEDIVERSE-OPERATOR-URL: ""

# Optional public support methods for the human Directory page. This block is
# absent by default in the UI. Each entry needs a title and exactly one of an
# absolute HTTPS url or a plain-text value. No HTML, Markdown, embeds, scripts,
# pixels, or third-party content are accepted.
# SUPPORT:
#   - title: "Liberapay"
#     url: "https://liberapay.com/example/"
#   - title: "Bitcoin"
#     value: "bc1qexample"
